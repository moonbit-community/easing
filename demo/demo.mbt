///|
/// D3-Ease MoonBit Demo
/// This demonstrates all the easing functions available in the library
fn main {
  println("D3-Ease MoonBit Port Demo")
  println("==============================")
  let t = 0.5 // Halfway point for demonstration
  println("Linear Easing:")
  println("  ease_linear(\{t}) = \{@easing.ease_linear(t)}")
  println("\nQuadratic Easing:")
  println("  ease_quad_in(\{t}) = \{@easing.ease_quad_in(t)}")
  println("  ease_quad_out(\{t}) = \{@easing.ease_quad_out(t)}")
  println("  ease_quad_in_out(\{t}) = \{@easing.ease_quad_in_out(t)}")
  println("\nCubic Easing:")
  println("  ease_cubic_in(\{t}) = \{@easing.ease_cubic_in(t)}")
  println("  ease_cubic_out(\{t}) = \{@easing.ease_cubic_out(t)}")
  println("  ease_cubic_in_out(\{t}) = \{@easing.ease_cubic_in_out(t)}")
  println("\nPolynomial Easing:")
  println("  ease_poly_in(\{t}) = \{@easing.ease_poly_in(t)}")
  println("  ease_poly_out(\{t}) = \{@easing.ease_poly_out(t)}")
  println("  ease_poly_in_out(\{t}) = \{@easing.ease_poly_in_out(t)}")
  println("\nSine Easing:")
  println("  ease_sin_in(\{t}) = \{@easing.ease_sin_in(t)}")
  println("  ease_sin_out(\{t}) = \{@easing.ease_sin_out(t)}")
  println("  ease_sin_in_out(\{t}) = \{@easing.ease_sin_in_out(t)}")
  println("\nExponential Easing:")
  println("  ease_exp_in(\{t}) = \{@easing.ease_exp_in(t)}")
  println("  ease_exp_out(\{t}) = \{@easing.ease_exp_out(t)}")
  println("  ease_exp_in_out(\{t}) = \{@easing.ease_exp_in_out(t)}")
  println("\nCircle Easing:")
  println("  ease_circle_in(\{t}) = \{@easing.ease_circle_in(t)}")
  println("  ease_circle_out(\{t}) = \{@easing.ease_circle_out(t)}")
  println("  ease_circle_in_out(\{t}) = \{@easing.ease_circle_in_out(t)}")
  println("\nBounce Easing:")
  println("  ease_bounce_in(\{t}) = \{@easing.ease_bounce_in(t)}")
  println("  ease_bounce_out(\{t}) = \{@easing.ease_bounce_out(t)}")
  println("  ease_bounce_in_out(\{t}) = \{@easing.ease_bounce_in_out(t)}")
  println("\nBack Easing:")
  println("  ease_back_in(\{t}) = \{@easing.ease_back_in(t)}")
  println("  ease_back_out(\{t}) = \{@easing.ease_back_out(t)}")
  println("  ease_back_in_out(\{t}) = \{@easing.ease_back_in_out(t)}")
  println("\nElastic Easing:")
  println("  ease_elastic_in(\{t}) = \{@easing.ease_elastic_in(t)}")
  println("  ease_elastic_out(\{t}) = \{@easing.ease_elastic_out(t)}")
  println("  ease_elastic_in_out(\{t}) = \{@easing.ease_elastic_in_out(t)}")
}
